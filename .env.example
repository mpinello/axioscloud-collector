# File letterale: NON eseguire con source. Copiare in .env e chmod 600 .env.
# Credenziali personali del proprio account famiglia, non credenziali del progetto.
AXIOS_CUSTOMER_ID=
AXIOS_USERNAME=
AXIOS_PASSWORD=
AXIOS_STUDENT_NAME=
# Esempio di formato: 2026/2027. Deve coincidere con l'anno attivo in Axios.
AXIOS_SCHOOL_YEAR=
AXIOS_CLASS_LABEL=Classe
DATA_DIR=data
COLLECT_COMMUNICATIONS=true
COLLECT_ACADEMIC=true
# L'apertura di comunicazioni/allegati può registrarne la lettura sul portale.
# Per abilitarla consapevolmente impostare true; per soli argomenti/compiti disabilitare COLLECT_COMMUNICATIONS.
ALLOW_MARK_READ=false
# Drive è facoltativo. Lasciare false per usare esclusivamente file locali.
DRIVE_UPLOAD=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Lasciare vuoto prima di google_authorize.py: crea una cartella dell'app.
GOOGLE_DRIVE_FOLDER_ID=
